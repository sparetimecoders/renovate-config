{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "configMigration": true,
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":pinDependencies",
    ":semanticCommits"
  ],
  "baseBranches": ["main"],
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 9am every weekday"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automergeStrategy": "squash",
  "automergeType": "pr",
  "hermit": {
    "enabled": true
  },
  "pre-commit": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Auto-merge minor/patch updates for CI tooling",
      "matchManagers": ["pre-commit", "dockerfile", "github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge patch updates with 7-day stabilization",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "platformAutomerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge minor dev dependency updates",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
